[Unit]
Description=Hub — interfaz web en localhost
After=default.target

[Service]
Type=simple
WorkingDirectory=@RAIZ@
Environment=HUB_HOME=@HUB_HOME@
# 🔴 El PATH de systemd no trae ~/.local/bin (decisión 81), y lo que el hub lanza
# en tmux —`claude`, sobre todo— sí lo necesita. Probarlo a mano no lo detecta,
# porque una shell interactiva sí lo tiene.
Environment=PATH=@PATH@
# 🔴 Para que un aborto deje rastro. `hub-web` se murió 14 veces con SIGABRT
# entre el 2 y el 4 de septiembre sin escribir una sola línea en el registro:
# el fallo se veía como «se cayó el hub» y no había por dónde empezar. Con esto
# el volcado de Python sale en `journalctl`, que es donde se va a mirar.
Environment=PYTHONFAULTHANDLER=1
ExecStart=@UV@ run uvicorn hub.web:app --host @HOST@ --port @PUERTO@
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
