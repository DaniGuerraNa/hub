[Unit]
# El secretario (decisión 298). Servicio PROPIO por lo mismo que los relés: es
# el único proceso que abre las llaves de sus fuentes —la sesión de Telegram
# del dueño, el acceso a su calendario—, y `hub-web` expone el puerto con una
# shell detrás (regla dura 8). La web sólo deja y lee cosas en su base.
Description=Hub — el secretario (fuentes, memoria y conversación)
After=default.target

[Service]
Type=simple
WorkingDirectory=@RAIZ@
Environment=HUB_HOME=@HUB_HOME@
Environment=PATH=@PATH@
Environment=HUB_PORT=@PUERTO@
ExecStart=@UV@ run python -m hub.secretario
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
