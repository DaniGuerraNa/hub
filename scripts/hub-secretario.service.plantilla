[Unit]
# El secretario (decisión 298). Servicio PROPIO por lo mismo que los relés: es
# el único proceso que abre las llaves de sus fuentes —la sesión de Telegram
# del dueño, el acceso a su calendario—, y `hub-web` expone el puerto con una
# shell detrás (regla dura 8). La web sólo deja y lee cosas en su base.
Description=Hub — el secretario (fuentes, memoria y conversación)
After=default.target

[Service]
Type=simple
WorkingDirectory=@RAIZ@
Environment=HUB_HOME=@HUB_HOME@
# Lo que ponía `uv run` y aquí se pone a mano (C-0266): el `bin` del entorno
# delante del PATH y `VIRTUAL_ENV`, para que lo que el hub lanza vea lo mismo.
Environment=PATH=@RAIZ@/.venv/bin:@PATH@
Environment=VIRTUAL_ENV=@RAIZ@/.venv
Environment=HUB_PORT=@PUERTO@
# Con el Python del entorno y no con `uv run` (C-0266): el envoltorio era un
# proceso de más que salía con 143 en cada parada —«Failed» en cada reinicio
# hecho a propósito, que tapaba los fallos de verdad— y miraba el lock al
# arrancar. El entorno lo dejan listo `instalar.sh` y `actualizar.sh`.
ExecStart=@RAIZ@/.venv/bin/python -m hub.secretario
Restart=always
RestartSec=15
# Parar es pedírselo (C-0266): con SIGTERM deja acabar el turno que contesta
# (hasta 45 s, `servicio.ESPERA_AL_PARAR_S`) y sale con 0. `mixed` manda la
# señal sólo al proceso principal: con el modo de por omisión `claude` la
# recibe a la vez y el turno muere igual. Lo que quede al salir él, o a los
# 60 s, lo mata systemd.
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=default.target
