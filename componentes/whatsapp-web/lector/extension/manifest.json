{
  "manifest_version": 3,
  "name": "Lector de WhatsApp para el hub",
  "version": "0.1.0",
  "description": "Lee los mensajes nuevos de WhatsApp Web y los deja para el secretario del hub. Sólo lee: no envía, no marca leído.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "fondo.js"},
  "content_scripts": [
    {"matches": ["https://web.whatsapp.com/*"], "js": ["enlace.js", "pagina.js"], "world": "MAIN", "run_at": "document_idle"},
    {"matches": ["https://web.whatsapp.com/*"], "js": ["puente.js"], "run_at": "document_idle"}
  ]
}
