{
  "enabledMcpjsonServers": [
    "puente-kvm"
  ],
  "permissions": {
    "allow": [
      "mcp__puente-kvm__estado",
      "mcp__puente-kvm__ver_pantalla",
      "mcp__puente-kvm__leer_documento",
      "mcp__puente-kvm__ver_pagina",
      "mcp__puente-kvm__transcribir_pagina",
      "mcp__puente-kvm__estado_lectura",
      "mcp__puente-kvm__resolver_linea",
      "mcp__puente-kvm__comprobar_huella",
      "mcp__puente-kvm__proponer_cambio",
      "mcp__puente-kvm__estado_cambio",
      "mcp__puente-kvm__escribir_cambio",
      "mcp__puente-kvm__ver_tramo",
      "Read(/**)",
      "Read(~/.local/share/puente-kvm/**)",
      "Edit(/trabajo/**)"
    ],
    "ask": [
      "mcp__puente-kvm__teclear",
      "mcp__puente-kvm__atajo",
      "mcp__puente-kvm__ir_a_linea",
      "mcp__puente-kvm__clic",
      "mcp__puente-kvm__rueda",
      "Edit(/src/**)",
      "Edit(/.claude/**)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(~/.config/puente-kvm/**)",
      "Edit(~/.config/puente-kvm/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 -X POST \"http://127.0.0.1:${PUENTE_PUERTO:-8794}/api/claude/actividad\" -H 'Content-Type: application/json' --data-binary @- >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 -X POST \"http://127.0.0.1:${PUENTE_PUERTO:-8794}/api/claude/actividad\" -H 'Content-Type: application/json' --data-binary @- >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 -X POST \"http://127.0.0.1:${PUENTE_PUERTO:-8794}/api/claude/actividad\" -H 'Content-Type: application/json' --data-binary @- >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
